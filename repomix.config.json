{
  "$schema": "https://repomix.com/schemas/config.json",
  "output": {
    "filePath": ".repomix/repo-map.md",
    "style": "markdown",
    "compress": true,
    "headerText": "Compressed signature-level repository map for src/lza_workbench. Generated by Repomix on demand for AI agents (gitignored to avoid commit churn).",
    "topFilesLength": 0,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "patterns": [
      {
        "pattern": "src/lza_workbench/**/schemas/**",
        "directoryStructureOnly": true
      }
    ]
  },
  "include": ["src/lza_workbench/**"],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "tests/**",
      "src/lza_workbench/resources/**",
      "resources/**",
      "customers/**",
      "**/customers/**",
      "**/__pycache__/**",
      "**/*.pyc"
    ]
  }
}
